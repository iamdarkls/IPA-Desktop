<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="IPA Desktop · 0.2.7" Width="1160" Height="860" MinWidth="940" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#10151F" Foreground="#EDF1F8" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <!-- Общий тёмный скроллбар: сохраняет штатный Track, команды страниц и перетаскивание. -->
    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="Background" Value="#455D7E"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="ThumbSurface" Background="{TemplateBinding Background}" CornerRadius="4" Margin="3"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#6587B4"/></Trigger>
              <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#8CB9FF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Цвет служебного угла ScrollViewer между вертикальной и горизонтальной полосами. -->
    <Style TargetType="ScrollViewer">
      <Style.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#101A29"/>
      </Style.Resources>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Background" Value="#101A29"/>
      <Setter Property="Width" Value="14"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border x:Name="ScrollSurface" Background="{TemplateBinding Background}" CornerRadius="7" SnapsToDevicePixels="True">
              <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"
                     Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}"
                     Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <Track.DecreaseRepeatButton><RepeatButton x:Name="DecreasePage" Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb x:Name="ScrollHandle" Style="{StaticResource ScrollThumb}" MinHeight="24"/></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton x:Name="IncreasePage" Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
              </Track>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                <Setter TargetName="ScrollHandle" Property="MinHeight" Value="0"/>
                <Setter TargetName="ScrollHandle" Property="MinWidth" Value="24"/>
                <Setter TargetName="DecreasePage" Property="Command" Value="ScrollBar.PageLeftCommand"/>
                <Setter TargetName="IncreasePage" Property="Command" Value="ScrollBar.PageRightCommand"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ScrollSurface" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Height" Value="14"/><Setter Property="Width" Value="Auto"/></Trigger>
      </Style.Triggers>
    </Style>
    <!-- Общие состояния кнопок, полей, вкладок и таблиц. -->
    <Style TargetType="Button">
      <Setter Property="Background" Value="#243247"/>
      <Setter Property="Foreground" Value="#EDF1F8"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#35465D"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="#8CB9FF"/>
                <Setter TargetName="B" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="#BCD6FF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Opacity" Value="0.65"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#8390A3"/>
                <Setter TargetName="B" Property="Background" Value="#1A2331"/>
                <Setter TargetName="B" Property="BorderBrush" Value="#263143"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Background" Value="#192333"/>
      <Setter Property="Foreground" Value="#EDF1F8"/>
      <Setter Property="BorderBrush" Value="#34445C"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="SelectionBrush" Value="#416EC4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
              <!-- Отступы задаются один раз: дополнительный Margin обрезает текст в невысоких полях. -->
              <ScrollViewer x:Name="PART_ContentHost" Margin="0" Padding="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="#699FFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="#151E2C"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#AABAD0"/>
      <Setter Property="Padding" Value="18,12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="B" Background="#10151F" Padding="{TemplateBinding Padding}" Margin="0,0,6,6" CornerRadius="8">
              <ContentPresenter ContentSource="Header"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#202D40"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="B" Property="Background" Value="#284871"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="#8CB9FF"/>
                <Setter TargetName="B" Property="BorderThickness" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="EnableRowVirtualization" Value="True"/>
      <Setter Property="EnableColumnVirtualization" Value="True"/>
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
      <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
      <Setter Property="Background" Value="#151E2C"/>
      <Setter Property="Foreground" Value="#EDF1F8"/>
      <Setter Property="RowBackground" Value="#182334"/>
      <Setter Property="AlternatingRowBackground" Value="#1C293B"/>
      <Setter Property="GridLinesVisibility" Value="None"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="RowHeight" Value="44"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="SelectionUnit" Value="FullRow"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#202E42"/>
      <Setter Property="Foreground" Value="#A8BCD8"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="LocalAppText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#EDF1F8"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="ToolTip" Value="{Binding FileDetails}"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#EDF1F8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#2A4B77"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="#1C293B"/>
      <Setter Property="Foreground" Value="#EDF1F8"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="B" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="B" Property="Background" Value="#2A4B77"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="B" Property="Background" Value="#284871"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinWidth" Value="180"/>
      <Setter Property="MaxDropDownHeight" Value="300"/>
      <Setter Property="Foreground" Value="#EDF1F8"/>
      <Setter Property="Background" Value="#1C293B"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="B" Background="#1C293B" BorderBrush="#34445C" BorderThickness="1" CornerRadius="8">
                      <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#AEC4E2" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="B" Property="BorderBrush" Value="#8CB9FF"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="SelectionContent" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,9,32,9" VerticalAlignment="Center"/>
              <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Background="#1C293B" Foreground="#EDF1F8" BorderThickness="0" Margin="6,3,30,3" Padding="6,4" VerticalContentAlignment="Center"/>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="#1C293B" BorderBrush="#405574" BorderThickness="1" CornerRadius="8" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Padding="4">
                  <ScrollViewer CanContentScroll="True">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEditable" Value="True">
                <Setter TargetName="SelectionContent" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Собственный шаблон не позволяет теме Windows подменять фон при IsEnabled=False. -->
    <Style x:Key="SetList" TargetType="ListBox">
      <Setter Property="Background" Value="#101A29"/>
      <Setter Property="Foreground" Value="#EDF1F8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <Border x:Name="SetListSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ScrollViewer Focusable="False" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsPresenter/>
              </ScrollViewer>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.65"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Карточки наборов: обычный клик переключает выбор, Ctrl не требуется. -->
    <Style x:Key="SetListItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Card" Background="#192738" BorderBrush="#30445D" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Card" Property="Background" Value="#25456C"/>
                <Setter TargetName="Card" Property="BorderBrush" Value="#6DA7F5"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="#9AC4FF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="24,18,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Image x:Name="BrandIcon" Width="46" Height="46" Margin="0,0,12,0"/>
          <TextBlock Text="IPA Desktop" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Border Background="#23354E" CornerRadius="6" Padding="8,4" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="0.2.7" Foreground="#AFCDF7" FontSize="12"/>
          </Border>
        </StackPanel>
        <TextBlock Text="Приложения для iPhone — поиск, загрузка и установка" Foreground="#9BACBF" Margin="0,6,0,20">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Visibility, ElementName=OperationNotice}" Value="Visible">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Right">
        <TextBlock x:Name="EngineVersion" Text="Движок не установлен" Foreground="#78B7FF" HorizontalAlignment="Right"/>
        <TextBlock x:Name="AccountLabel" Text="Аккаунт не проверен" Margin="0,6,0,0" Foreground="#9BACBF"/>
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="1">
      <TextBlock x:Name="UpdateNotice" Visibility="Collapsed" Foreground="#8CBAFF" Margin="0,0,0,8"/>
      <WrapPanel x:Name="AccountActions">
        <Button x:Name="Login" Content="Войти в Apple Account" Background="#3878E5"/>
        <Button x:Name="AccountInfo" Content="Проверить аккаунт"/>
        <Button x:Name="Logout" Content="Выйти"/>
        <Button x:Name="OpenFolder" Content="Папка IPA"/>
        <Button x:Name="ShowLastReport" Content="Итог операции" IsEnabled="False"/>
      </WrapPanel>
    </StackPanel>
    <TabControl Grid.Row="2" Margin="0,12,0,16">
      <!-- Поиск и независимая очередь; состав выбранного не зависит от текущей выдачи. -->
      <TabItem x:Name="SearchTab" Header="Поиск и загрузка">
        <Grid Margin="18">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid Height="40" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Query" Padding="12,6" VerticalContentAlignment="Center" ToolTip="Название или числовой App Store ID"/>
            <Button x:Name="Search" Content="Найти" Grid.Column="1" Margin="10,0,0,0"/>
          </Grid>
          <DataGrid x:Name="Apps" Grid.Row="1" SelectionMode="Extended">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Приложение" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="App Store ID" Binding="{Binding ID}" Width="180"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock x:Name="SearchEmpty" Grid.Row="1" Text="Найдите приложение по названию или App Store ID" Foreground="#8FA4BE" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasItems, ElementName=Apps}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <WrapPanel Grid.Row="2" Margin="0,8,0,0">
            <Button x:Name="Versions" Content="Список версий"/>
            <ComboBox x:Name="VersionList" Margin="0,0,8,8"/>
            <Button x:Name="VersionTable" Content="Таблица версий…"/>
            <Button x:Name="VersionInfo" Content="Сведения"/>
            <Button x:Name="AddChosen" Content="В выбранное" ToolTip="Добавить выделенные строки и выбранную версию. Можно также добавлять двойным кликом по строке."/>
            <Button x:Name="Download" Content="Скачать (0)" Background="#3878E5"/>
          </WrapPanel>
          <Border Grid.Row="3" Background="#101A29" BorderBrush="#2B3E58" BorderThickness="1" CornerRadius="8" Padding="10,6">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <DockPanel>
                <Button x:Name="RetryDownloads" Content="Повторить ошибки (0)" DockPanel.Dock="Right" Padding="8,3" Margin="8,0,0,0" FontSize="12"/>
                <Button x:Name="ForgetDownloadErrors" Content="Сбросить ошибки" ToolTip="Убрать сохранённые ошибки без повторной загрузки" DockPanel.Dock="Right" Padding="8,3" Margin="8,0,0,0" FontSize="12"/>
                <Button x:Name="ClearChosen" Content="Очистить" DockPanel.Dock="Right" Padding="8,3" Margin="8,0,0,0" FontSize="12"/>
                <TextBlock x:Name="ChosenCount" TextTrimming="CharacterEllipsis" Text="Двойной клик — добавить в выбранное" VerticalAlignment="Center" Foreground="#AFC6E7" FontSize="12"/>
              </DockPanel>
              <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,5,0,0" Height="54">
                <ItemsControl x:Name="ChosenApps">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#22354F" CornerRadius="6" Margin="0,0,8,2" Padding="9,4">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Label}" ToolTip="{Binding ID}" MaxWidth="260" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                          <Button Content="×" Tag="{Binding Key}" ToolTip="Убрать из выбранного" Padding="6,0" Margin="8,0,0,0" Background="#22354F"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <DockPanel Grid.Row="2" Margin="0,6,0,0" LastChildFill="True">
                <TextBlock Text="Набор" VerticalAlignment="Center" Foreground="#AFC6E7" Margin="0,0,8,0"/>
                <ComboBox x:Name="SearchSet" IsEditable="True" IsTextSearchEnabled="False" MinWidth="180" Width="210" Margin="0,0,8,0" ToolTip="Выберите набор или введите название нового"/>
                <Button x:Name="AddToSet" Content="Добавить в набор" Padding="10,6" Margin="0,0,8,0"/>
                <TextBlock x:Name="SearchSetStatus" Text="Выберите набор или введите новое название" Foreground="#9BACBF" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" VerticalAlignment="Center"/>
              </DockPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <!-- Локальные IPA и установка; аккаунт берётся только из метаданных файла. -->
      <TabItem x:Name="FilesTab" Header="Файлы и устройство">
        <Grid Margin="18">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <WrapPanel>
              <Button x:Name="RefreshFiles" FontSize="12" Padding="10,6" Margin="0,0,8,6" Content="Обновить файлы"/>
              <Button x:Name="ImportFile" FontSize="12" Padding="10,6" Margin="0,0,8,6" Content="Добавить IPA…"/>
              <Button x:Name="Devices" FontSize="12" Padding="10,6" Margin="0,0,8,6" Content="Найти iPhone" Background="#16704C"/>
              <Button x:Name="DeviceInfo" FontSize="12" Padding="10,6" Margin="0,0,8,6" Content="Об iPhone…"/>
              <ComboBox x:Name="DeviceList" DisplayMemberPath="DisplayLabel" FontSize="12" Margin="0,0,8,6"/>
            </WrapPanel>
            <DockPanel Margin="0,0,0,6" LastChildFill="True">
              <Button x:Name="OpenAppleSupportHelp" Content="Помощь Apple" DockPanel.Dock="Right" FontSize="12" Padding="8,4" Margin="6,0,0,0"/>
              <Button x:Name="CheckAppleSupport" Content="Проверить драйвер" DockPanel.Dock="Right" FontSize="12" Padding="8,4" Margin="6,0,0,0"/>
              <Button x:Name="WifiHelp" Content="Wi-Fi: помощь" DockPanel.Dock="Right" FontSize="12" Padding="8,4" Margin="6,0,0,0"/>
              <CheckBox x:Name="SearchWifi" Content="USB + Wi-Fi (экспериментально)" ToolTip="Искать также по Wi-Fi, сохраняя поиск USB" Foreground="#EDF1F8" VerticalAlignment="Center" FontSize="12" Margin="0,0,10,0"/>
              <TextBlock x:Name="WifiStatus" Text="USB" Foreground="#AFC6E7" VerticalAlignment="Center" FontSize="12" Margin="0,0,10,0"/>
              <TextBlock x:Name="AppleSupportStatus" Text="Компоненты Apple: проверка при запуске" Foreground="#9BACBF" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,6" LastChildFill="True">
              <Button x:Name="SelectAllFiles" Content="Выбрать все (0)" DockPanel.Dock="Right" Padding="10,5" Margin="8,0,0,0" ToolTip="Добавить все IPA текущего фильтра в выбранное снизу. Ранее выбранные файлы сохранятся."/>
              <TextBlock Text="Apple Account" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#AFC6E7" FontSize="12"/>
              <ComboBox x:Name="FileAccount" FontSize="12" DockPanel.Dock="Left" DisplayMemberPath="Label" Width="300" MaxDropDownHeight="280" Margin="0,0,12,0" ToolTip="Фильтр по аккаунту из IPA. Не переключает аккаунт входа в программу."/>
              <TextBlock x:Name="FilesSummary" Text="Чтение файлов…" VerticalAlignment="Center" FontSize="12" Foreground="#9BACBF" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
          </StackPanel>
          <Grid Grid.Row="1">
          <DataGrid x:Name="Files" SelectionMode="Extended">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Приложение" Binding="{Binding DisplayName}" Width="*" MinWidth="140" ElementStyle="{StaticResource LocalAppText}"/>
              <DataGridTextColumn Header="Версия" Binding="{Binding Version}" Width="90"/>
              <DataGridTextColumn Header="Apple Account" Binding="{Binding AppleAccount}" Width="280"/>
              <DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="140"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock x:Name="FilesEmpty" Visibility="Collapsed" IsHitTestVisible="False" Text="IPA пока нет. Скачайте приложения или нажмите «Добавить IPA…»." TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" Margin="24,45,24,12" VerticalAlignment="Center" Foreground="#9BACBF"/>
          </Grid>
          <Border Grid.Row="3" Background="#101A29" BorderBrush="#2B3E58" BorderThickness="1" CornerRadius="8" Padding="10,6">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <DockPanel>
                <Button x:Name="RetryInstalls" Content="Повторить ошибки (0)" DockPanel.Dock="Right" Padding="8,3" Margin="8,0,0,0" FontSize="12"/>
                <Button x:Name="ForgetInstallErrors" Content="Сбросить ошибки" ToolTip="Убрать сохранённые ошибки без повторной установки" DockPanel.Dock="Right" Padding="8,3" Margin="8,0,0,0" FontSize="12"/>
                <Button x:Name="ClearInstall" Content="Очистить" DockPanel.Dock="Right" Padding="8,3" Margin="8,0,0,0" FontSize="12"/>
                <TextBlock x:Name="InstallCount" TextTrimming="CharacterEllipsis" Text="Двойной клик — выбрать IPA" VerticalAlignment="Center" Foreground="#AFC6E7" FontSize="12"/>
              </DockPanel>
              <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,5,0,0" Height="42">
                <ItemsControl x:Name="ChosenFiles">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#22354F" CornerRadius="6" Margin="0,0,8,2" Padding="9,4">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding FileDetails}" MaxWidth="260" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                          <Button Content="×" Tag="{Binding Path}" ToolTip="Убрать из выбранного" Padding="6,0" Margin="8,0,0,0" Background="#22354F"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                <Button x:Name="FileInfo" Content="Сведения об IPA…"/>
                <Button x:Name="AddInstall" Content="В выбранное" ToolTip="Двойной клик по файлу также добавляет его в выбранное."/>
                <Button x:Name="InstallFiles" Content="Установить (0)" Background="#3878E5"/>
                <Button x:Name="DeleteFiles" Content="Удалить выбранные IPA (0)" Background="#713B48" ToolTip="Переместить выбранные внизу IPA в корзину. Приложения на iPhone сохранятся."/>
              </WrapPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem x:Name="SettingsTab" Header="Настройки">
        <Grid x:Name="SettingsHost">
        <ScrollViewer x:Name="SettingsContent" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24">
            <Border Background="#1C293B" BorderBrush="#34445C" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="Уведомления" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <CheckBox x:Name="SoundsEnabled" Content="Звуковой сигнал после успешного скачивания и установки" Foreground="#EDF1F8"/>
                <TextBlock Text="Один сигнал после завершения всей очереди без ошибок. Используется системный звук Windows." Foreground="#9BACBF" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"/>
              </StackPanel>
            </Border>
            <Border Background="#1C293B" BorderBrush="#34445C" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,24">
              <StackPanel>
                <TextBlock Text="IPA Desktop" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="GuiVersionStatus" Text="Установлена версия 0.2.7" Foreground="#8CBAFF" Margin="0,8,0,14"/>
                <CheckBox x:Name="CheckGuiUpdates" Content="Проверять новые версии программы при запуске" Foreground="#EDF1F8" Margin="0,0,0,16"/>
                <WrapPanel>
                  <Button x:Name="CheckGuiUpdate" Content="Проверить версию"/>
                  <Button x:Name="InstallGuiUpdate" Content="Установить обновление" IsEnabled="False" Background="#3878E5"/>
                  <Button x:Name="OpenGuiReleases" Content="Все версии"/>
                </WrapPanel>
                <TextBlock Text="Установка — после подтверждения. Программа перезапустится, ваши IPA и настройки сохранятся." Foreground="#9BACBF" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <TextBlock Text="Движок ipatool" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Источник: Sorvigolova / ipatool · GitHub Releases" Foreground="#78B7FF" Margin="0,12,0,24"/>
            <CheckBox x:Name="AutoUpdate" Foreground="#EDF1F8" Content="Проверять и устанавливать новые релизы при запуске" Margin="0,0,0,20"/>
            <WrapPanel>
              <Button x:Name="CheckUpdate" Content="Проверить обновления" Background="#3878E5"/>
              <Button x:Name="Rollback" Content="Откатить движок"/>
              <Button x:Name="OpenRelease" Content="Открыть релизы на GitHub"/>
            </WrapPanel>
            <TextBlock Text="Обновление и откат ipatool сохраняют отдельный комплект для iPhone. Вход и 2FA выполняются в консоли ipatool." Foreground="#9BACBF" TextWrapping="Wrap" Margin="0,16,0,24"/>
            <Border Background="#1C293B" BorderBrush="#34445C" BorderThickness="1" CornerRadius="10" Padding="20">
              <StackPanel>
                <TextBlock Text="Инструменты для iPhone" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="DeviceToolsVersion" Text="Комплект не установлен" Foreground="#8CBAFF" Margin="0,8,0,12"/>
                <TextBlock Text="Источник: iamdarkls / IPA-Desktop · наша сборка libimobiledevice и ideviceinstaller" Foreground="#9BACBF" TextWrapping="Wrap" Margin="0,0,0,16"/>
                <CheckBox x:Name="AutoUpdateDeviceTools" Content="Проверять и обновлять инструменты при запуске" Foreground="#EDF1F8" Margin="0,0,0,16"/>
                <WrapPanel>
                  <Button x:Name="CheckDeviceUpdate" Content="Проверить инструменты" Background="#3878E5"/>
                  <Button x:Name="RollbackDevices" Content="Откатить комплект"/>
                  <Button x:Name="OpenDeviceReleases" Content="Релизы комплекта"/>
                </WrapPanel>
                <TextBlock Text="Переключение — после проверки запуска всех трёх утилит. Предыдущий комплект сохраняется; откат отключает только его автообновление. Каталог обновляется отдельно при поиске." Foreground="#9BACBF" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="Журнал">
        <DockPanel Margin="18">
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button x:Name="ExportDiagnostics" Content="Экспорт диагностики…"/>
            <TextBlock Text="Версии программы и очищенный журнал" Foreground="#9BACBF" VerticalAlignment="Center" Margin="6,0,0,8"/>
          </WrapPanel>
          <TextBox x:Name="Journal" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
        </DockPanel>
      </TabItem>
      <TabItem Header="Наборы и хранилище">
        <Grid Margin="18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Background="#101A29" BorderBrush="#2B3E58" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,14,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <TextBlock Text="Наборы приложений" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="SetsCount" Text="Наборов пока нет" Foreground="#83B8FF" Margin="0,6,0,8"/>
                <TextBlock Text="Отметьте несколько наборов. Приложения объединятся в одной очереди без повторов." Foreground="#9BACBF" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"/>
                <ListBox x:Name="AppSets" SelectionMode="Multiple" Height="156" Style="{StaticResource SetList}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource SetListItem}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <DockPanel>
                        <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="13"/>
                      </DockPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="SetPreview" Text="Отметьте один или несколько наборов." Foreground="#AFC6E7" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,12" MaxHeight="85" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="UseSet" Content="В очередь скачивания (0)" Background="#3878E5" Margin="0,0,0,8"/>
                <Button x:Name="EditSet" Content="Редактировать набор…" Margin="0,0,0,8"/>
                <Button x:Name="DeleteSet" Content="Удалить наборы (0)" Background="#50313F" Margin="0,0,0,12"/>
                <Border Background="#26374D" Height="1" Margin="0,0,0,12"/>
                <TextBlock Text="Сохранить выбор из поиска" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox x:Name="SetName" MaxLength="64" Height="38" ToolTip="Название нового или существующего набора" Margin="0,0,0,8"/>
                <Button x:Name="SaveSet" Content="Сохранить из поиска" ToolTip="Дополнить набор выбранными приложениями или списком последней загрузки" Margin="0,0,0,8"/>
                <TextBlock x:Name="SetStatus" Text="Наборы хранят только ID. Скачивание выполняется под текущим Apple Account." Foreground="#9BACBF" TextWrapping="Wrap" FontSize="12"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
          <Grid Grid.Column="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="Хранилище IPA" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock x:Name="StorageSummary" Text="Подсчёт файлов…" Foreground="#AFC6E7" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <WrapPanel>
                <Button x:Name="RefreshStorage" Content="Обновить"/>
                <Button x:Name="SelectOld" Content="Выделить старые версии"/>
                <Button x:Name="DeleteStorage" Content="Удалить выбранные копии" Background="#713B48"/>
              </WrapPanel>
              <TextBlock Text="Старые версии определяются по версии приложения, отдельно для каждого Apple Account. Удаление — в корзину, после подтверждения." Foreground="#9BACBF" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
            </StackPanel>
            <DataGrid x:Name="StorageFiles" Grid.Row="1" SelectionMode="Extended">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Приложение" Binding="{Binding DisplayName}" Width="*" MinWidth="140" ElementStyle="{StaticResource LocalAppText}"/>
                <DataGridTextColumn Header="Версия" Binding="{Binding Version}" Width="80"/>
                <DataGridTextColumn Header="Apple Account" Binding="{Binding AppleAccount}" Width="180"/>
                <DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="90"/>
                <DataGridTextColumn Header="Состояние" Binding="{Binding StorageStatus}" Width="165"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Grid>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="3">
      <Border x:Name="OperationNotice" Visibility="Collapsed" Background="#38232C" BorderBrush="#D36B7B" BorderThickness="1" CornerRadius="7" Padding="10,5" Margin="0,0,0,8">
        <DockPanel>
          <Button x:Name="DismissNotice" Content="×" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,2" ToolTip="Скрыть уведомление; итог останется доступен"/>
          <Button x:Name="NoticeDetails" Content="Подробнее…" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,2"/>
          <Button x:Name="NoticeRetry" Content="Повторить ошибки" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,2"/>
          <TextBlock x:Name="NoticeText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13"/>
        </DockPanel>
      </Border>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="120"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock x:Name="Status" Text="Готово" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
        <DockPanel Margin="0,0,0,7">
          <TextBlock x:Name="TransferDetail" Text="" DockPanel.Dock="Right" Foreground="#8CB9FF" FontSize="12" MaxWidth="360" TextTrimming="CharacterEllipsis" Margin="10,0,0,0"/>
          <TextBlock x:Name="OperationDetail" Text="" Foreground="#AFC6E7" FontSize="12" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="100" Foreground="#5094FF" Background="#29364C"/>
      </StackPanel>
      <Button x:Name="Cancel" Grid.Column="1" Content="Отмена" IsEnabled="False" Margin="16,0,0,0"/>
    </Grid>
    </StackPanel>
  </Grid>
</Window>

