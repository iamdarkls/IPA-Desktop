<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <SolidColorBrush x:Key="CanvasBrush" Color="#171D27" />
    <SolidColorBrush x:Key="TextBrush" Color="#EAF0F8" />
    <SolidColorBrush x:Key="ControlBrush" Color="#2A3545" />
    <SolidColorBrush x:Key="DividerBrush" Color="#344155" />
    <SolidColorBrush x:Key="InputBrush" Color="#1E2734" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#202936" />
    <SolidColorBrush x:Key="RaisedBrush" Color="#293649" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A4B2C5" />
    <SolidColorBrush x:Key="AccentBrush" Color="#377DCF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4C91E4" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#B7D8FF" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#382C37" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#F2BCC7" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#614450" />
    <SolidColorBrush x:Key="HoverBrush" Color="#2B3A4D" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#304C6B" />
    <SolidColorBrush x:Key="SelectionHoverBrush" Color="#39597C" />
    <SolidColorBrush x:Key="FocusBrush" Color="#8CBFFF" />
  </Styles.Resources>
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontFamily" Value="Segoe UI" />
  </Style>
  <Style Selector="Button">
    <Setter Property="Height" Value="36" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource InputBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Height" Value="36" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>
  <Style Selector="TabItem">
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="DataGrid">
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="SelectionMode" Value="Extended" />
    <Setter Property="GridLinesVisibility" Value="None" />
    <Setter Property="RowHeight" Value="46" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="ListBox">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
  </Style>
  <Style Selector="Button.compact">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Margin" Value="0,0,8,6" />
  </Style>
  <Style Selector="TabControl">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="DataGrid /template/ Border#DataGridBorder">
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="DataGrid /template/ DataGridRowsPresenter#PART_RowsPresenter">
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="DataGridRow /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource SelectionBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="DataGridRow:selected:focus /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource SelectionBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource SelectionHoverBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="DataGridRow:selected:pointerover:focus /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource SelectionHoverBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="DataGridColumnHeader /template/ Grid">
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.table-frame">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="1" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.table-frame &gt; DataGrid">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox">
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="DataGridCell">
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="DataGridCell /template/ Grid#FocusVisual">
    <Setter Property="Opacity" Value="0.65" />
  </Style>
  <Style Selector="DataGridCell /template/ Grid#FocusVisual Rectangle">
    <Setter Property="Stroke" Value="{DynamicResource FocusBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
  </Style>
  <Style Selector="Expander">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader /template/ Border#ToggleButtonBackground">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="DataGridCell TextBlock">
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="AutoCompleteBox">
    <Setter Property="Height" Value="36" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.toolbar">
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.remove-chip">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="DockPanel.control-row &gt; Button">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Margin" Value="8,0,0,0" />
  </Style>
  <Style Selector="Border.selection-card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16,12" />
  </Style>
  <Style Selector="Border.selection-chip">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="0,0,8,2" />
    <Setter Property="Padding" Value="9,4" />
  </Style>
  <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector="Button.menu-action">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="13" />
  </Style>
</Styles>
