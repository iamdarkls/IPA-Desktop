<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="using:IpaDesktop"
        x:Class="IpaDesktop.JournalWindow" x:DataType="ui:DesktopViewModel" Width="900" Height="580" MinWidth="560" MinHeight="360"
        Title="Журнал · IPA Desktop" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <Grid Margin="20" RowDefinitions="Auto,Auto,*">
    <DockPanel Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Content="Экспорт диагностики…" ui:ActionIcon.Kind="Export" Command="{CompiledBinding ExportCommand}" />
      <TextBlock Text="Журнал операций" FontSize="22" VerticalAlignment="Center" />
    </DockPanel>
    <CheckBox Grid.Row="1" Content="Показывать новые записи" IsChecked="{CompiledBinding FollowJournal, Mode=TwoWay}" Margin="0,0,0,10" />
    <TextBox x:Name="JournalText" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
             Text="{CompiledBinding JournalText, Mode=OneWay}" ScrollViewer.VerticalScrollBarVisibility="Auto" />
  </Grid>
</Window>
